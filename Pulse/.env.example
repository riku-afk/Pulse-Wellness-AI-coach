# Copy to .env and fill in. Expo only exposes vars prefixed with EXPO_PUBLIC_
# to the app bundle. Restart the dev server with `npx expo start -c` after changes.

# Backend API base URL.
# localhost only works on web/emulator — use your machine's LAN IP
# (e.g. http://192.168.x.x:5000) or the Railway URL for physical devices.
EXPO_PUBLIC_BACKEND_URL=http://localhost:5000

# Firebase Web API key (app identifier, not a secret) — used for ID-token refresh.
EXPO_PUBLIC_FIREBASE_API_KEY=

# Optional: override the on-device LLM download URL (GGUF file).
# Defaults to Gemma 3 1B Q4_K_M from the ungated unsloth Hugging Face mirror.
# For production, self-host the file on your own CDN.
# EXPO_PUBLIC_LOCAL_MODEL_URL=
