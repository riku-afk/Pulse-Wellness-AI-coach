# Copy to .env and fill in. Never commit the real .env.

# Server
PORT=5000

# AI provider: groq | gemini | ollama
AI_PROVIDER=groq

# Set to true once the subscription/paywall ships: cloud AI then requires
# plan: 'premium' on the user doc; free users run the on-device model.
ENFORCE_AI_PLAN=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Only needed when AI_PROVIDER=ollama
OLLAMA=
OLLAMA_MODEL=

# Firebase
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Full service-account JSON as a single-line string. Required for push
# notifications AND for API auth (ID-token verification) — without it,
# protected routes return 503.
FIREBASE_SERVICE_ACCOUNT_JSON=
